# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml แล้วใส่ API Key จริง (ไฟล์ secrets.toml ถูก .gitignore ไว้แล้ว)
# บน Streamlit Community Cloud ให้วางเนื้อหาเดียวกันนี้ในเมนู Settings → Secrets
GROQ_API_KEY = "ใส่_GROQ_API_KEY_ของคุณที่นี่"

